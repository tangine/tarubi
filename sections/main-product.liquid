<section id="{{ section.id }}" class="section-wrapper" style="padding-top:{{ section.settings.padding_top | append: 'px' }};padding-bottom:{{ section.settings.padding_bottom | append: 'px' }};">
<div class="section section-product {{ section.settings.container_type }}">
  <div class="product-media">
    {% for image in product.images %}
      <div class="product-media__image">
        <img src="{{ image | image_url }}" alt="{{ image.alt }}">
      </div>
    {% endfor %}
  </div>
  <div class="product-info">
    {%- for block in section.blocks -%}
      {% case block.type %}
        {% when '@app' %}
          {% render block %}
        {% when 'variant_picker' %}
          <div class="product-info__variants">
            {% render 'product-variant-picker', product: product %}'
          </div>
        {% when 'title' %}
          <div class="product-info__title">
            {{ product.title }}
          </div>
        {% when 'price' %}
          <div class="product-info__price">
            {{ product.price | money }}
          </div>
      {% endcase %}
    {%- endfor -%}
  </div>
</div>
</section>


{% stylesheet %}
.section-product {
display: grid;
grid-template-columns: repeat(2,1fr);
gap: 10px;
}
@media screen {max-width: 762px} {
.section-product {
grid-template-columns: 1fr;
}
}

.section-product .product-media {overflow: auto}
.section-product .product-media .product-media__image {width: 100%;aspect-ratio: 1}
.section-product .product-media .product-media__image img {width: 100%;height: 100%;object-fit:contain}
{% endstylesheet %}
{% schema %}
{
  "name": "t:names.product",
  "settings": [
    {
      "type": "select",
      "id": "container_type",
      "label": "t:settings.section_width",
      "default": "tarubi-container",
      "options": [
        {
          "value": "w-full",
          "label": "t:options.full"
        },
        {
          "value": "tarubi-container",
          "label": "t:options.default"
        }
      ]
    },
    {
      "type": "header",
      "content": "填充"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "顶部",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "label": "底部",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "t:names.title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:names.price",
      "limit": 1
    },
    {
      "type": "quantity",
      "name": "t:names.quantity",
      "limit": 1
    },
    {
      "type": "vendor",
      "name": "t:settings.vendor",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1
    }
  ],
  "presets": [
    {
      "name": "t:names.product"
    }
  ]
}
{% endschema %}