<script type="module" src="{{ 'variant-picker.js' | asset_url }}"></script>

<div class="product-variant-picker">
  <variant-picker>
    {%- for option in product.options_with_values -%}
      <fieldset>
        <legend>{{ option.name }}</legend>
        {%- for value in option.values -%}
          <label>
            <input type="radio" name="{{ option.name }}" value="{{ value | escape }}" data-option-value-id="{{ value.id }}" />
            <span class="variant-option__button-label__text">{{ value | escape }}</span>
          </label>
        {%- endfor -%}
      </fieldset>
    {%- endfor -%}
  </variant-picker>
</div>