<script type="module" src="{{ 'variant-picker.js' | asset_url }}"></script>

{% liquid
  assign selectedVariant = product.selected_or_first_available_variant
%}

{% liquid
  assign options_with_values = product.options_with_values
  assign selected_location = ""
  for option in options_with_values
    assign option_index = forloop.index0
    for option_value in option.values
      if option_value.name == selectedVariant.options[option_index]
        assign selected_location = selected_location | append: ',' | append : option_index
      endif
    endfor
  endfor
%}

<variant-picker data-section-id="{{ section.id }}"  data-product-id="{{ product.id }}" data-product-url="{{ product.url }}">
  <div>{{ selected_location | json }}</div>
  {%- for product_option in product.options_with_values -%}
    <fieldset data-fieldset-index="{{ product_option.position | minus : 1 }}">
      <legend>{{ product_option.name | escape }}</legend>
      {%- for product_option_value in product_option.values -%}
        <label class="variant-option__button-label">
          <input type="radio"
                 name="{{ product_option.name }}"
                 value="{{ product_option_value | escape }}"
                 data-available="{{ product_option_value.available }}"
                 aria-label="{{ product_option_value | escape }}"
                 data-fieldset-index="{{ product_option.position | minus: 1 }}"
                 data-input-index="{{ forloop.index0 }}"
                 data-location="{{ product_option.position | minus : 1 }}-{{ forloop.index0 }}"
                 data-option-value-id="{{ product_option_value.id }}"
                 data-option-name="{{ product_option.name | escape }}"
                 data-option-value="{{ product_option_value | escape }}"
                 data-option-available="{{ product_option_value.available }}"
                 data-product-url="{{ product_option_value.product_url }}"
                 data-variant-id="{{ product_option_value.variant.id }}"
            {% if product_option_value.selected %}
              data-current-checked="true"
              checked
            {% else %}
              data-current-checked="false"
            {% endif %}
          />
          <span class="variant-option__button-label__text">{{ product_option_value | escape }}</span>
        </label>
      {%- endfor -%}
    </fieldset>
  {%- endfor -%}
  <script type="application/json" data-selected-variant>
    {{ product.selected_or_first_available_variant | json }}
  </script>
  <script type="application/json" data-variants>
    {{ product.variants | json }}
  </script>
</variant-picker>
