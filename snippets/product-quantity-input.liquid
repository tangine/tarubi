<script type="module" src="{{ 'quantity-input.js' | asset_url }}"></script>
<quantity-input>
  <button class="quantity__button quantity__minus" type="button" name="minus">-</button>
  <label>
    <input class="quantity__input" type="number" name="quantity" min="1" value="{{ quantity }}" />
  </label>
  <button class="quantity__button quantity__plus" type="button" name="plus">+</button>
</quantity-input>